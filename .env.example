# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
# Defaults to https://www.cyoracinnamon.com when unset — set it explicitly in Vercel too.
NEXT_PUBLIC_SITE_URL=https://www.cyoracinnamon.com

# Optional search-engine ownership verification via HTML meta tag (content value only, not the whole tag).
# Not needed if you verify with a DNS TXT record instead.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Email delivery for enquiry forms (server-side only — never prefix with NEXT_PUBLIC_)
# Uses the Resend HTTP API. Leave blank in development to log enquiries to the console instead.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=enquiries@example.com
ENQUIRY_FROM_EMAIL=CYORA Website <website@example.com>

# Optional Cloudflare Turnstile spam protection. If both are set, the forms require a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
